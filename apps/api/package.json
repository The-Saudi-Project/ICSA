{
  "name": "@rw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "seed:admin": "tsx src/scripts/seedPlatformAdmin.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "dev:standalone": "tsx scripts/dev-standalone.mts",
    "indexes:check": "tsx scripts/check-indexes.mts",
    "indexes:sync": "tsx scripts/sync-indexes.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@rw/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "mongoose": "^8.9.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
