# ═══════════════════════════════════════════════════════════════
#  ENVIRONMENT TEMPLATE — names only, NEVER real values.
#  Copy to apps/api/.env (git-ignored) and fill in locally.
#  Nothing here is used yet: Phase 0 delivered documentation only.
#  Sensitivity: SECRET = backend only, never sent to the browser.
# ═══════════════════════════════════════════════════════════════

# ── core ───────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
PORT=4000
LOG_LEVEL=info

# ── database ─── SECRET (contains a password) ──────────────────
# Local:  mongodb://127.0.0.1:27017/restaurant_dev
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# ── auth ─── SECRET · generate with: openssl rand -base64 48 ───
# Optional in development (an ephemeral per-process secret is generated, so
# sessions do not survive a restart). REQUIRED in production, minimum 32 chars.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
# Set only when api. and app. are sibling subdomains, so the refresh cookie is
# shared. Leave blank for localhost.
COOKIE_DOMAIN=

# ── first platform admin (one-time bootstrap) ──────────────────
# Used ONLY by: npm run seed:admin --workspace @rw/api
# There is no other way to create the first admin — every platform route
# requires one. Choose a long password, run the script once, then DELETE the
# password line below.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=      # SECRET, min 12 chars, remove after seeding
PLATFORM_ADMIN_NAME=

# ── table / customer sessions ─── SECRET ───────────────────────
TABLE_SESSION_SECRET=
TABLE_SESSION_TTL=15m                     # session TOKEN lifetime (renewed by heartbeat)

# ── table token encryption ─── HIGHLY SENSITIVE ────────────────
# AES-256-GCM key, exactly 32 bytes base64. Lets an owner reprint a
# table's QR without rotating the physical tag.
# Generate: openssl rand -base64 32
# Losing this means every table token must be rotated and every tag rewritten.
TABLE_TOKEN_KEY=

# ── privacy ─── SECRET ─────────────────────────────────────────
# Salt for hashing IPs in audit logs. Raw IPs are never stored.
IP_HASH_SALT=

# ── public URLs ─── not secret ─────────────────────────────────
PUBLIC_APP_URL=http://localhost:5174      # base of the QR/NFC payload: <PUBLIC_APP_URL>/t/<token>
CORS_ORIGIN=http://localhost:5174         # exact frontend origin, comma-separated if several

# ── menu images ────────────────────────────────────────────────
# none      = uploads refused with an explanation. Everything else in the menu
#             still works, so development is never blocked on an account.
# cloudinary = development and demo. Free tier.
#
# TODO BEFORE REAL PRODUCTION: move to Cloudflare R2. Cloudinary's free tier is
# fine for development and demo; R2 has no egress fees, which is what matters
# once real customers load menu images all day. Tracked in PROJECT_STATE.md §22.
IMAGE_PROVIDER=none
CLOUDINARY_CLOUD_NAME=                    # not secret, appears in image URLs
CLOUDINARY_API_KEY=                       # not secret, sent to the browser
CLOUDINARY_API_SECRET=                    # SECRET, backend only, signs uploads
IMAGE_UPLOAD_MAX_BYTES=5000000

# ═══════════════════════════════════════════════════════════════
#  PHASE 2 — leave blank until that phase. Sandbox credentials first.
# ═══════════════════════════════════════════════════════════════
# REDIS_URL=                              # SECRET
# PAYMENT_PROVIDER=                       # e.g. moyasar
# PAYMENT_API_KEY=                        # HIGHLY SENSITIVE
# PAYMENT_WEBHOOK_SECRET=                 # HIGHLY SENSITIVE — verifies webhook signatures
# SMS_PROVIDER=                           # console driver in development
# SMS_API_KEY=                            # SECRET
# SMS_SENDER_ID=                          # not secret — must be CITC-registered for KSA

# ═══════════════════════════════════════════════════════════════
#  PHASE 3 — accounting / POS. Credentials are encrypted per-tenant
#  in the database; this key protects them at rest.
# ═══════════════════════════════════════════════════════════════
# INTEGRATION_CREDENTIAL_KEY=             # HIGHLY SENSITIVE, AES-256-GCM, 32 bytes base64

# ── frontend note ──────────────────────────────────────────────
# apps/web has its own .env with VITE_-prefixed vars ONLY.
# Anything VITE_-prefixed is compiled into the JS bundle and is
# PUBLIC. Never put a secret there.
# VITE_API_BASE_URL=http://localhost:4000/api/v1
