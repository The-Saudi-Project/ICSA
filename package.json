{
  "name": "restaurant-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant NFC/QR restaurant self-ordering platform (Saudi Arabia)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rw/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "test:security": "npm run test:security --workspaces --if-present",
    "clean": "node -e \"['packages/shared','apps/api'].forEach(p=>require('fs').rmSync(p+'/dist',{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "pdfkit": "^0.19.1"
  }
}
